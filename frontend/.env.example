# Same-origin prefix. Vite forwards /api to http://127.0.0.1:8000 in development.
VITE_API_BASE_URL=/api

# Keep mock data enabled until FastAPI is available. Use false to send real requests.
VITE_USE_MOCK=true

# Optional mock states for local QA. Use error or empty, then restart Vite.
VITE_MOCK_STATE=
